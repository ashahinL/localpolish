{
  "name": "localpolish",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "pack": "wxt zip",
    "shots": "npm run build && node scripts/shots.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "bridge:install": "node bridge/install.mjs",
    "bridge:uninstall": "node bridge/uninstall.mjs",
    "postinstall": "wxt prepare",
    "bench:runtime": "node bench/runtime/run.mjs",
    "bench:lifecycle": "node bench/runtime/lifecycle.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lexical/history": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "draft-js": "^0.11.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lexical": "^0.52.0",
    "prettier": "^3.9.10",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "quill": "2.0.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "slate": "0.94.1",
    "slate-history": "0.93.0",
    "slate-react": "0.98.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "draft-js": {
      "immutable": "3.8.4"
    }
  }
}
